{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_camerasTab": {
            "type": "panel",
            "label": "Cameras",
            "items": {
                "_camerasHelp": {
                    "type": "staticText",
                    "text": "One row per camera. A login typed into the URL is moved into the user and password fields at the next start, and passwords are stored encrypted.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "cameras": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "5%",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "13%",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "url",
                            "title": "RTSP URL",
                            "width": "26%",
                            "default": "rtsp://"
                        },
                        {
                            "type": "text",
                            "attr": "username",
                            "title": "User",
                            "width": "11%",
                            "default": ""
                        },
                        {
                            "type": "password",
                            "attr": "password",
                            "title": "Password",
                            "width": "11%",
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "transport",
                            "title": "Transport",
                            "width": "8%",
                            "default": "tcp",
                            "noTranslation": true,
                            "options": [
                                {
                                    "label": "TCP",
                                    "value": "tcp"
                                },
                                {
                                    "label": "UDP",
                                    "value": "udp"
                                }
                            ]
                        },
                        {
                            "type": "checkbox",
                            "attr": "keyframesOnly",
                            "title": "Key frames only",
                            "width": "9%",
                            "default": false
                        },
                        {
                            "type": "checkbox",
                            "attr": "audio",
                            "title": "Sound",
                            "width": "6%",
                            "default": false
                        },
                        {
                            "type": "number",
                            "attr": "prebuffer",
                            "title": "Pre-recording (s)",
                            "width": "11%",
                            "min": 0,
                            "max": 30,
                            "default": 0
                        }
                    ]
                },
                "_keyframesHelp": {
                    "type": "staticText",
                    "text": "Key frames only: use it when snapshots of an H.265 camera come out grey. Sound: mp4 clips get the sound of the camera (AAC), when the camera sends it in its RTSP stream; GIFs and snapshots stay silent.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_devicesTab": {
            "type": "panel",
            "label": "Devices",
            "items": {
                "_deviceManager": {
                    "type": "deviceManager",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "style": {
                        "width": "100%",
                        "height": "100%",
                        "overflow": "hidden"
                    }
                }
            }
        },
        "_triggersTab": {
            "type": "panel",
            "label": "Triggers",
            "items": {
                "_triggersHelp": {
                    "type": "staticText",
                    "text": "A trigger starts a recording when a state is written, e.g. the doorbell or motion state of the DoorBird adapter. Every write counts, the cooldown ignores further writes for some seconds. Duration 0 and format Default use the values of the Recording tab.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "triggers": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "4%",
                            "default": true
                        },
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": "State",
                            "width": "14%",
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "condition",
                            "title": "When",
                            "width": "9%",
                            "default": "truthy",
                            "options": [
                                {
                                    "label": "Value is true",
                                    "value": "truthy"
                                },
                                {
                                    "label": "Every write",
                                    "value": "any"
                                }
                            ]
                        },
                        {
                            "type": "number",
                            "attr": "cooldown",
                            "title": "Cooldown (s)",
                            "width": "6%",
                            "min": 0,
                            "max": 3600,
                            "default": 10
                        },
                        {
                            "type": "objectId",
                            "attr": "condState",
                            "title": "Only if",
                            "width": "10%",
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "condOp",
                            "title": "Comparison",
                            "width": "6%",
                            "default": "eq",
                            "noTranslation": true,
                            "options": [
                                {
                                    "label": "=",
                                    "value": "eq"
                                },
                                {
                                    "label": "≠",
                                    "value": "ne"
                                },
                                {
                                    "label": ">",
                                    "value": "gt"
                                },
                                {
                                    "label": "<",
                                    "value": "lt"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "condValue",
                            "title": "Value",
                            "width": "5%",
                            "default": ""
                        },
                        {
                            "type": "autocompleteSendTo",
                            "attr": "camera",
                            "title": "Camera",
                            "width": "8%",
                            "command": "listCameras",
                            "freeSolo": true,
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "action",
                            "title": "Action",
                            "width": "8%",
                            "default": "record",
                            "options": [
                                {
                                    "label": "Video clip",
                                    "value": "record"
                                },
                                {
                                    "label": "Snapshot",
                                    "value": "snapshot"
                                },
                                {
                                    "label": "Snapshot and video clip",
                                    "value": "both"
                                }
                            ]
                        },
                        {
                            "type": "number",
                            "attr": "duration",
                            "title": "Duration (s)",
                            "width": "5%",
                            "min": 0,
                            "max": 60,
                            "default": 0
                        },
                        {
                            "type": "select",
                            "attr": "format",
                            "title": "Format",
                            "width": "7%",
                            "default": "",
                            "options": [
                                {
                                    "label": "Default",
                                    "value": ""
                                },
                                {
                                    "label": "MP4 video",
                                    "value": "mp4"
                                },
                                {
                                    "label": "GIF animation",
                                    "value": "gif"
                                }
                            ]
                        },
                        {
                            "type": "autocompleteSendTo",
                            "attr": "profiles",
                            "title": "Message",
                            "width": "22%",
                            "command": "listProfiles",
                            "freeSolo": true,
                            "default": ""
                        }
                    ]
                },
                "_conditionHelp": {
                    "type": "staticText",
                    "text": "Only if: the trigger fires only while the state of this column has the value, e.g. 0_userdata.0.away = true. Empty = always.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_recordingTab": {
            "type": "panel",
            "label": "Recording",
            "items": {
                "recordDuration": {
                    "type": "number",
                    "label": "Clip length (s)",
                    "min": 1,
                    "max": 60,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "recordFormat": {
                    "type": "select",
                    "label": "Clip format",
                    "options": [
                        {
                            "label": "MP4 video",
                            "value": "mp4"
                        },
                        {
                            "label": "GIF animation",
                            "value": "gif"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "maxClipLength": {
                    "type": "number",
                    "label": "Maximum clip length (s)",
                    "help": "With pre-recording, a further event during a clip extends it up to this length",
                    "min": 5,
                    "max": 300,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "videoMode": {
                    "type": "select",
                    "label": "MP4 encoding",
                    "help": "Copy needs H.264 from the camera and ignores width and frame rate",
                    "newLine": true,
                    "options": [
                        {
                            "label": "Re-encode (smaller file, uses CPU)",
                            "value": "transcode"
                        },
                        {
                            "label": "Copy the camera stream (almost no CPU)",
                            "value": "copy"
                        }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "videoWidth": {
                    "type": "number",
                    "label": "MP4 width (px, 0 = original)",
                    "newLine": true,
                    "min": 0,
                    "max": 3840,
                    "disabled": "data.videoMode === 'copy'",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "videoFps": {
                    "type": "number",
                    "label": "MP4 frame rate (0 = original)",
                    "min": 0,
                    "max": 60,
                    "disabled": "data.videoMode === 'copy'",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "gifWidth": {
                    "type": "number",
                    "label": "GIF width (px)",
                    "newLine": true,
                    "min": 64,
                    "max": 1280,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "gifFps": {
                    "type": "number",
                    "label": "GIF frame rate",
                    "min": 1,
                    "max": 25,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "snapshotWidth": {
                    "type": "number",
                    "label": "Snapshot width (px, 0 = original)",
                    "newLine": true,
                    "min": 0,
                    "max": 3840,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "prebufferEnabled": {
                    "type": "checkbox",
                    "label": "Pre-recording",
                    "help": "Keeps the last seconds before an event. Each camera with pre-recording keeps one ffmpeg process running (stream copy, little CPU).",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "prebufferDir": {
                    "type": "text",
                    "label": "Folder for the pre-recording (empty = temp folder of the system)",
                    "disabled": "!data.prebufferEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                }
            }
        },
        "_sendTab": {
            "type": "panel",
            "label": "Send",
            "items": {
                "_sendHelp": {
                    "type": "staticText",
                    "text": "A profile says where a result goes and what is sent. Triggers and timelapses choose profiles by name in their column Message (several separated by commas, empty = no message); scripts with profiles: 'Name'.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_attachHelp": {
                    "type": "staticText",
                    "text": "Attachment: Everything sends snapshots, clips and timelapse videos, Snapshot only and Clip only one kind, Text only sends the text at once when the trigger fires, without a file. Text: {camera}, {date} and {time} are replaced.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_targetsHelp": {
                    "type": "staticText",
                    "text": "Telegram, MAX, Email, Pushover, Discord, Matrix, Signal, WhatsApp, Gotify and ntfy are built in (messengers that cannot send files get a text). For other adapters enter a JSON message with {file}, {caption}, {camera}, {text}.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "profiles": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "5%",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "12%",
                            "default": ""
                        },
                        {
                            "type": "autocomplete",
                            "attr": "instance",
                            "title": "Instance",
                            "width": "13%",
                            "freeSolo": true,
                            "default": "",
                            "options": [
                                "telegram.0",
                                "max.0",
                                "email.0",
                                "pushover.0",
                                "discord.0",
                                "matrix-org.0",
                                "signal-cmb.0",
                                "whatsapp-cmb.0",
                                "gotify.0",
                                "ntfy.0"
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "recipient",
                            "title": "Recipient",
                            "width": "14%",
                            "default": ""
                        },
                        {
                            "type": "select",
                            "attr": "attach",
                            "title": "Attachment",
                            "width": "12%",
                            "default": "all",
                            "options": [
                                {
                                    "label": "Everything",
                                    "value": "all"
                                },
                                {
                                    "label": "Snapshot only",
                                    "value": "snapshot"
                                },
                                {
                                    "label": "Clip only",
                                    "value": "clip"
                                },
                                {
                                    "label": "Text only",
                                    "value": "none"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "text",
                            "title": "Text",
                            "width": "18%",
                            "default": "{camera} {date} {time}"
                        },
                        {
                            "type": "text",
                            "attr": "template",
                            "title": "Template (JSON, optional)",
                            "width": "26%",
                            "default": ""
                        }
                    ]
                }
            }
        },
        "_aiTab": {
            "type": "panel",
            "label": "AI check",
            "items": {
                "_agentHelp": {
                    "type": "staticText",
                    "text": "Optional, with ioBroker.pi-agent and a model that understands pictures: when a trigger fires, the files go out as before, and pi-agent looks at a snapshot. When the picture meets a criterion, the profiles of its row get an extra message, e.g. \"🔍 Door: a person — A man with a parcel at the door\". One row per criterion in your own words (e.g. \"a person\" or \"an animal in the garden\"). Without a match, or when pi-agent does not answer in time, there is no extra message; nothing else is lost.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "agentInstance": {
                    "type": "instance",
                    "adapter": "pi-agent",
                    "allowDeactivate": true,
                    "label": "pi-agent instance for the AI check",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "agentTimeout": {
                    "type": "number",
                    "label": "Wait for the answer of pi-agent (s)",
                    "min": 5,
                    "max": 120,
                    "default": 30,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "agentChecks": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "7%",
                            "default": true
                        },
                        {
                            "type": "text",
                            "attr": "criterion",
                            "title": "Criterion",
                            "width": "38%",
                            "default": ""
                        },
                        {
                            "type": "autocompleteSendTo",
                            "attr": "profiles",
                            "title": "Profiles",
                            "width": "33%",
                            "command": "listProfiles",
                            "freeSolo": true,
                            "default": ""
                        },
                        {
                            "type": "checkbox",
                            "attr": "state",
                            "title": "State",
                            "width": "9%",
                            "default": false
                        },
                        {
                            "type": "number",
                            "attr": "hold",
                            "title": "Hold (s)",
                            "width": "13%",
                            "min": 5,
                            "max": 3600,
                            "default": 60
                        }
                    ]
                },
                "_statesHelp": {
                    "type": "staticText",
                    "text": "State: each camera gets the state cameras.<camera>.ai.<criterion>, true for the hold time after pi-agent saw the criterion in a snapshot of a trigger, then false again (like a motion sensor). Scripts, Blockly or the Scenes adapter can react to it, e.g. switch on the light only for a person. A criterion with State is checked at every trigger, also without profiles. The answer comes some seconds after the trigger.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_timelapseTab": {
            "type": "panel",
            "label": "Timelapse",
            "items": {
                "_timelapseHelp": {
                    "type": "staticText",
                    "text": "A picture every interval (from the pre-recording while it runs). Once a day at the set time the pictures become an MP4 video with the width of the Recording tab and are deleted. The button cameras.<camera>.timelapse builds the video at once.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "timelapses": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "7%",
                            "default": true
                        },
                        {
                            "type": "autocompleteSendTo",
                            "attr": "camera",
                            "title": "Camera",
                            "width": "18%",
                            "command": "listCameras",
                            "freeSolo": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "attr": "interval",
                            "title": "Interval (min)",
                            "width": "13%",
                            "min": 1,
                            "max": 1440,
                            "default": 5
                        },
                        {
                            "type": "text",
                            "attr": "at",
                            "title": "Video at (HH:MM)",
                            "width": "15%",
                            "default": "23:55"
                        },
                        {
                            "type": "number",
                            "attr": "fps",
                            "title": "Frames per second",
                            "width": "15%",
                            "min": 1,
                            "max": 60,
                            "default": 10
                        },
                        {
                            "type": "autocompleteSendTo",
                            "attr": "profiles",
                            "title": "Message",
                            "width": "32%",
                            "command": "listProfiles",
                            "freeSolo": true,
                            "default": ""
                        }
                    ]
                }
            }
        },
        "_remoteTab": {
            "type": "panel",
            "label": "NAS (SFTP)",
            "items": {
                "_remoteHelp": {
                    "type": "staticText",
                    "text": "The copy runs in the background after each clip, snapshot and timelapse video, into a folder per camera. Give the server a user that may only write into this folder. The files are not encrypted on the server.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "remoteEnabled": {
                    "type": "checkbox",
                    "label": "Copy every new file to an SFTP server (NAS)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "remoteHost": {
                    "type": "text",
                    "label": "Host",
                    "newLine": true,
                    "disabled": "!data.remoteEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "remotePort": {
                    "type": "number",
                    "label": "SSH port",
                    "min": 1,
                    "max": 65535,
                    "disabled": "!data.remoteEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "remoteUser": {
                    "type": "text",
                    "label": "User",
                    "newLine": true,
                    "disabled": "!data.remoteEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "remotePassword": {
                    "type": "password",
                    "label": "Password",
                    "repeat": false,
                    "disabled": "!data.remoteEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "remoteDirectory": {
                    "type": "text",
                    "label": "Folder on the server",
                    "help": "A folder per camera is created below it",
                    "newLine": true,
                    "disabled": "!data.remoteEnabled",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "remoteHostKey": {
                    "type": "text",
                    "label": "Fingerprint of the server (SHA256:…)",
                    "help": "Empty = not verified; the connection test shows the fingerprint",
                    "newLine": true,
                    "disabled": "!data.remoteEnabled",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "remoteKeepDays": {
                    "type": "number",
                    "label": "Days kept on the server (0 = keep all)",
                    "min": 0,
                    "max": 3650,
                    "newLine": true,
                    "disabled": "!data.remoteEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "_remoteTest": {
                    "type": "sendTo",
                    "command": "testRemote",
                    "label": "Test connection",
                    "variant": "outlined",
                    "useNative": true,
                    "showProcess": true,
                    "disabled": "!data.remoteEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "_storageTab": {
            "type": "panel",
            "label": "Storage",
            "items": {
                "outputDir": {
                    "type": "text",
                    "label": "Folder for the files (empty = data folder of the instance)",
                    "xs": 12,
